<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>BetterChasesPlus.Enhanced</AssemblyName>
    <RootNamespace>BetterChasesPlus</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- no symbols, no Debug Directory, no embedded paths -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <Optimize>true</Optimize>
    <!-- Supply your own Enhanced reference DLLs (not redistributed here).
         Defaults to refs/, or override on the command line, e.g.:
         dotnet build -c Release -p:ScriptHookVDotNet3Path="...\ScriptHookVDotNet3.dll" -p:LemonUIPath="...\LemonUI.SHVDN3.dll" -->
    <ScriptHookVDotNet3Path Condition="'$(ScriptHookVDotNet3Path)' == ''">refs/ScriptHookVDotNet3.dll</ScriptHookVDotNet3Path>
    <LemonUIPath Condition="'$(LemonUIPath)' == ''">refs/LemonUI.SHVDN3.dll</LemonUIPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="src/**/*.cs" />
    <Reference Include="ScriptHookVDotNet3"><HintPath>$(ScriptHookVDotNet3Path)</HintPath><Private>False</Private></Reference>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="LemonUI.SHVDN3"><HintPath>$(LemonUIPath)</HintPath><Private>False</Private></Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
